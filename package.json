{
  "name": "kirina-korean",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "validate": "node scripts/validate.mjs",
    "sw:revision": "node scripts/sw-revision.mjs --print",
    "sw:update": "node scripts/sw-revision.mjs --write",
    "check": "npm run validate && npm run lint && npm run typecheck && npm run test && npm run build",
    "smoke:http": "node scripts/http-smoke.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:offline": "node scripts/smoke-offline.mjs",
    "check:smoke": "node scripts/check-smoke.mjs",
    "check:all": "npm run check && npm run check:smoke"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.0.10",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
