{
  "name": "kirina-korean",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "validate": "npm run content:check && node --import tsx scripts/validate.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "speech:prepare": "node scripts/build-speech-corpus.mjs",
    "speech:generate": "python scripts/generate-speech-assets.py scripts/speech-corpus.json public/assets/audio/ko",
    "check": "npm run validate && npm run lint && npm run typecheck && npm run typecheck:strict && npm run test && npm run build",
    "smoke:http": "node --import tsx scripts/http-smoke.mjs",
    "smoke:browser": "node --import tsx scripts/smoke-browser.mjs",
    "check:smoke": "node scripts/check-smoke.mjs",
    "check:all": "npm run check && npm run check:smoke",
    "typecheck:strict": "tsc --project tsconfig.strict.json --noEmit && tsc --project tsconfig.content.json --noEmit",
    "check:release": "node --import tsx scripts/check-release.mjs",
    "content:prepare": "node scripts/build-curriculum-runtime.mjs",
    "content:check": "node scripts/build-curriculum-runtime.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-kr": "^5.3.0",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.2.12",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.60.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.0"
  }
}
